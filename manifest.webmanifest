{
  "id": "./",
  "name": "Lufora（ルフォラ）写真編集",
  "short_name": "Lufora",
  "description": "Lufora（ルフォラ）— Creativity grows naturally. 写真に文字・付箋・スタンプ・フィルターを。スマホでもパソコンでも、オフラインでも使える写真編集アプリ。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "lang": "ja",
  "dir": "ltr",
  "theme_color": "#FBF8F1",
  "background_color": "#F4EFE4",
  "categories": ["photo", "graphics", "lifestyle", "productivity"],
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "https://ryvona.github.io/lufora/manifest.webmanifest" }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "テンプレートから作る", "short_name": "テンプレート", "description": "写真に重ねるデザインやコラージュを選ぶ", "url": "./?a=tpl",
      "icons": [{ "src": "icons/sc-template-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "新規作成・最近の作品", "short_name": "新規作成", "description": "白紙から作る・写真を開く・最近の作品", "url": "./?a=new",
      "icons": [{ "src": "icons/sc-new-96.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photos", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".gif"] }] }
  },
  "screenshots": [
    { "src": "screens/phone-1.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "写真に文字やスタンプを重ねて編集" },
    { "src": "screens/phone-2.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "フィルターと色の調整" },
    { "src": "screens/phone-3.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "テンプレートやコラージュですぐに仕上げ" },
    { "src": "screens/wide-1.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "パソコンでは大きな画面でじっくり編集" }
  ]
}
